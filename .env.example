# Шаблон настроек. Скопируйте в .env рядом с этим файлом и впишите ключи:
#
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# Файл .env в репозиторий не попадает — он в .gitignore.

# ── Обязательные ─────────────────────────────────────────────────────────────

# Извлечение обязательств. Ключ: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# Веса диаризации pyannote. Токен типа Read: https://huggingface.co/settings/tokens
# Дополнительно нужно принять условия модели на её странице, иначе скачивание
# вернёт 403:
#   https://huggingface.co/pyannote/speaker-diarization-community-1
#   https://huggingface.co/pyannote/segmentation-3.0
# В Docker-образе веса уже лежат внутри, но код всё равно требует токен
# перед загрузкой пайплайна.
HF_TOKEN=hf_...

# ── Нужен только для генерации тестового аудио ───────────────────────────────
# Само приложение без него работает. Используется в testset/make_audio.py.
OPENAI_API_KEY=sk-...

# ── Необязательные: у всех есть рабочие значения по умолчанию ────────────────

# Размер модели faster-whisper: tiny | base | small | medium | large-v3.
# small — компромисс скорости и качества. Больше модель — заметно дольше
# на CPU, выигрыш на разборчивом созвоне невелик.
#WHISPER_MODEL=small

# Язык записи для распознавания. Пусто — автоопределение (медленнее и
# ошибается на коротких репликах).
#STT_LANGUAGE=uk

# Модель диаризации на Hugging Face.
#DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# Предел размера загружаемого файла, МБ.
#MAX_UPLOAD_MB=100

# Таймаут запроса к DeepSeek, секунды. Модель рассуждает перед ответом,
# на трёхминутной записи это может занять минуту и больше.
#DEEPSEEK_TIMEOUT=180

# Сколько часов держать загруженный файл. Плеер тянет аудио с сервера,
# поэтому сразу после обработки удалять нельзя.
#JOB_TTL_HOURS=24

# Путь к ffmpeg, если его нет в PATH.
#FFMPEG_BINARY=ffmpeg

# ── Поведение сервера ────────────────────────────────────────────────────────

# Гасить процесс, когда закрыли вкладку. Удобно локально: модели занимают
# гигабайты, держать их после работы незачем. Срабатывает только для
# браузера с той же машины (127.0.0.1).
# НА СЕРВЕРЕ ОБЯЗАТЕЛЬНО 0 — иначе сервис может выключиться сам.
#SHUTDOWN_ON_DISCONNECT=1

# Сколько ждать после ухода страницы, прежде чем гасить, секунды.
#BYE_GRACE_SEC=8

# Сколько терпеть молчание браузера, секунды. Фоновая вкладка пингует
# раз в минуту, поэтому меньше двух минут ставить нельзя.
#ALIVE_TIMEOUT_SEC=150

# Разрешённые origin через запятую — только если фронт поднимают отдельно
# от бэкенда. По умолчанию не нужно: статику отдаёт тот же сервер.
#CORS_ORIGINS=

# ── Публичное развёртывание (docker compose --profile public) ────────────────
# Нужны, только когда сервис выставляется в интернет через Caddy.
# Для локального запуска пропустите весь блок.

# Имя, на которое выпускается сертификат. Своего домена нет — подойдёт
# nip.io: 203-0-113-10.nip.io резолвится в 203.0.113.10 без регистрации.
#DOMAIN=203-0-113-10.nip.io

# Логин и bcrypt-хеш пароля для входа на стенд. Хеш получить так
# (пароль вводится дважды):
#   docker run --rm -it caddy:2 caddy hash-password
#BASIC_AUTH_USER=demo
#BASIC_AUTH_HASH=$2a$14$...

# Куда приложение слушает напрямую. На сервере оставьте 127.0.0.1 —
# наружу отдаёт Caddy. Для доступа из локальной сети: 0.0.0.0
#APP_BIND=127.0.0.1
#APP_PORT=8000
