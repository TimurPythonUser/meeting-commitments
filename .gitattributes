# Переводы строк фиксируем явно, иначе Git на Windows перепишет их сам.
# Для run.bat это не косметика: cmd.exe спотыкается на многострочных
# конструкциях if (...) с одиночным LF.

* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Бинарники не трогать
*.wav  binary
*.mp3  binary
*.m4a  binary
*.mp4  binary
*.png  binary
*.jpg  binary
