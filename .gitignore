# Ключи — никогда не коммитить
.env
.env.local

# Окружение
.venv/
__pycache__/
*.py[cod]

# Кэши
.pytest_cache/
.ruff_cache/

# Мусор ОС
.DS_Store
Thumbs.db

# Видео-прохождение в репозиторий не кладём: исходная запись экрана весит
# сотни мегабайт, а готовый ролик прикладывается к сдаче отдельно.
*.mp4
*.mov

# Аудио тест-сета НЕ игнорируем: задание требует включить его в сдачу.
# backend/tests/fixtures/*.wav и testset/manual/audio/*.wav должны попасть в репозиторий.
