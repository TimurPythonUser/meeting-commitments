# Caddy перед приложением: HTTPS и пароль на публичный стенд.
#
# Домен и хеш пароля приходят из окружения (.env):
#   DOMAIN            — имя, на которое выпускается сертификат
#   BASIC_AUTH_USER   — логин, по умолчанию demo
#   BASIC_AUTH_HASH   — bcrypt-хеш пароля
#
# Хеш получается так (пароль вводится дважды):
#   docker run --rm -it caddy:2 caddy hash-password
#
# Нет своего домена — подойдёт nip.io: имя вида 203-0-113-10.nip.io
# резолвится в 203.0.113.10 без регистрации, и Let's Encrypt выдаёт на
# него сертификат. На голый IP сертификат не выдают.
#
# Пароль здесь — не «аккаунт в продукте», а замок на публичный стенд:
# без него любой, кто узнает адрес, будет гонять распознавание за ваш счёт.

{$DOMAIN} {
	basic_auth {
		{$BASIC_AUTH_USER:demo} {$BASIC_AUTH_HASH}
	}

	# Обработка трёх минут аудио занимает минуты — дефолтных таймаутов мало.
	reverse_proxy app:8000 {
		transport http {
			read_timeout 900s
			write_timeout 900s
		}
	}

	# Аудио отдаётся кусками по Range, сжимать его незачем — только текст.
	encode {
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
		}
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}
